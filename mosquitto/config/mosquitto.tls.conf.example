# Copy this to mosquitto.conf (or merge with it) to require TLS.
#
# Setup:
#   1. Generate a self-signed CA + broker cert for testing:
#        ./mosquitto/gen-certs.sh
#      (writes ca.crt, server.crt, server.key into mosquitto/config/certs/)
#      For production, use certs from a real CA instead.
#   2. Mount mosquitto/config/certs/ into the container (docker-compose.yml
#      already does this if MQTT_TLS_ENABLED is set -- see its comments).
#   3. Set MQTT_USE_TLS=true and MQTT_CA_CERT=/path/to/ca.crt on every
#      proxy and the collector.

listener 8883
cafile /mosquitto/config/certs/ca.crt
certfile /mosquitto/config/certs/server.crt
keyfile /mosquitto/config/certs/server.key
allow_anonymous true
persistence true
persistence_location /mosquitto/data/
log_dest stdout
